{
  "name": "n8n-nodes-ttdu",
  "version": "0.3.3",
  "description": "n8n community node for TTDU (Tools That Don't Upload): run document flows (receipt photos to PDF, payroll check, redaction, HWP to PDF) on this PC's offline runner or the TTDU hub API.",
  "license": "MIT",
  "author": {
    "name": "Park Jihoon (Tools That Don't Upload)",
    "email": "hello@toolsthatdontupload.com"
  },
  "homepage": "https://github.com/etacbae6768-a11y/n8n-nodes-ttdu#readme",
  "keywords": [
    "n8n-community-node-package",
    "ttdu",
    "pdf",
    "hwp",
    "redaction",
    "offline"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/TtduApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Ttdu/Ttdu.node.js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/etacbae6768-a11y/n8n-nodes-ttdu.git"
  },
  "bugs": {
    "url": "https://github.com/etacbae6768-a11y/n8n-nodes-ttdu/issues"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "n8n-workflow": "^2.16.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "node build.cjs",
    "prepublishOnly": "node build.cjs"
  }
}
